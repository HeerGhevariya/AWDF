# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/task_management_system

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=24h

# ─── Groq AI  (https://console.groq.com/keys) ─────────────────────────────────
# IMPORTANT: Keep this key on the backend only — never expose it to the frontend.
GROQ_API_KEY=your_groq_api_key_here

